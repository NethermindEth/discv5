{
  "name": "@nethermindeth/enr",
  "version": "3.0.0-backport-306",
  "description": "Ethereum name record",
  "type": "module",
  "files": [
    "lib"
  ],
  "exports": {
    ".": {
      "import": "./lib/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "*",
        "lib/*",
        "lib/*/index"
      ]
    }
  },
  "types": "./lib/index.d.ts",
  "scripts": {
    "check-types": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "yarn build",
    "lint": "eslint --color --ext .ts src/ test/",
    "test": "yarn test:unit",
    "test:perf": "NODE_OPTIONS='--max-old-space-size=4096 --loader=ts-node/esm' benchmark 'bench/**/*.bench.ts' --config .bench.yaml",
    "test:unit": "mocha 'test/unit/**/*.test.ts'"
  },
  "pre-push": [
    "lint"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NethermindEth/discv5"
  },
   "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "discovery",
    "discv5",
    "ethereum",
    "p2p"
  ],
  "author": "ChainSafe Systems",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/ChainSafe/discv5/issues"
  },
  "homepage": "https://github.com/ChainSafe/discv5#readme",
  "devDependencies": {
    "@libp2p/peer-id-factory": "^4.0.3",
    "@types/bn.js": "^4.11.5",
    "@types/mocha": "^10",
    "mocha": "^10",
    "tsx": "^4"
  },
  "dependencies": {
    "@ethereumjs/rlp": "^5.0.2",
    "@libp2p/crypto": "^4.0.1",
    "@libp2p/interface": "^1.1.1",
    "@libp2p/peer-id": "^4.0.4",
    "@multiformats/multiaddr": "^12.1.10",
    "@scure/base": "^1.2.1",
    "ethereum-cryptography": "^2.2.0"
  }
}
